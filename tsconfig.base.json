{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@overnight-mountain/source"],
    "paths": {
      "@om/csv-parser": ["./packages/csv-parser/src/index.ts"],
      "@om/db": ["./packages/db/src/index.ts"],
      "@om/ai": ["./packages/ai/src/index.ts"]
    }
  }
}
